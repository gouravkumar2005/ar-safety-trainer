# Copy to .env and adjust. All values are optional.
PORT=8787
# Where the SQLite database file lives
DB_PATH=data/ar-safety-trainer.db
# Comma-separated web origins allowed to call the API (the Android app's
# https://localhost is always allowed)
CORS_ORIGINS=https://localhost:5173,https://ar-safety-trainer.vercel.app
# How long a login lasts on a device, in days
SESSION_TTL_DAYS=30
# 1 if behind a reverse proxy / load balancer
TRUST_PROXY=0
