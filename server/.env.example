# Copy to .env and adjust. All values are optional.
PORT=8787
# Production: Postgres connection string (e.g. from neon.tech — use the
# "pooled" string, it ends with ?sslmode=require). Leave unset locally.
DATABASE_URL=
# Local only: where the built-in Postgres keeps its data
DATA_DIR=data/pglite
# Comma-separated web origins allowed to call the API (the Android app's
# https://localhost is always allowed)
CORS_ORIGINS=https://localhost:5173,https://ar-safety-trainer.vercel.app
# How long a login lasts on a device, in days
SESSION_TTL_DAYS=30
# 1 if behind a reverse proxy / load balancer
TRUST_PROXY=0
